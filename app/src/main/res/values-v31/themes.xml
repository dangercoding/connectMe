<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ConnectMe" parent="android:Theme.Material.Light.NoActionBar">
        <!-- 1. Match enableEdgeToEdge() immediately to prevent bar flicker -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- 2. Use dark icons for the light background -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- 3. Use your app's actual background color (#FAFBFC) to prevent flashes -->
        <item name="android:windowBackground">#FAFBFC</item>

        <!-- Native Splash Screen attributes (API 31+) -->
        <item name="android:windowSplashScreenBackground">#FAFBFC</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/main_app_logo</item>
    </style>
</resources>